# Railway PostgreSQL bağlantı adresi (Railway panelinden "Connect" > "Postgres Connection URL")
# Örnek: postgresql://postgres:PAROLA@HOST:PORT/railway
DATABASE_URL=

# Sunucu portu (Railway otomatik atar; lokal için 3000)
PORT=3000

# Yönetim paneli şifresi. Production'da zorunludur.
ADMIN_PASSWORD=degistirilecek-guclu-sifre

# Cookie imzası için ayrı gizli değer. Boş bırakılırsa ADMIN_PASSWORD kullanılır.
ADMIN_SESSION_SECRET=degistirilecek-uzun-rastgele-deger

# Railway volume bağlayacaksanız mount path'i /data yapıp bu klasörü kullanın.
UPLOAD_DIR=/data/uploads
UPLOAD_PUBLIC_PATH=/uploads
UPLOAD_MAX_BYTES=5242880

# --- Google Analytics 4 & Google Ads dönüşüm takibi ---
# Hepsi opsiyoneldir; boş bırakılırsa hiçbir takip kodu siteye eklenmez.
# GA4 ölçüm kimliği (Analytics > Yönetici > Veri akışları): G-XXXXXXXXXX
GA_MEASUREMENT_ID=
# Google Ads etiket/dönüşüm kimliği (Veri Yöneticisi > Etiket kimlikleri): AW-18278727405
GOOGLE_ADS_ID=AW-18278727405
# NOT: AküPort dönüşümleri olay-tabanlıdır (whatsapp_click, phone_call event'leri).
# Bu yüzden aşağıdaki label'lar BOŞ kalabilir; etiket (AW-...) yüklüyken olay adıyla
# eşleşip dönüşüm sayılır. Klasik "AW-XXX/label" dönüşümü eklersen ilgili label'ı doldur.
ADS_CALL_LABEL=
ADS_WHATSAPP_LABEL=
ADS_FORM_LABEL=
